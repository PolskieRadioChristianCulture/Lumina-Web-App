{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lumina-push",
  "main": "src/entry.js",
  "durable_objects": {
    "bindings": [{ "name": "OWNER_PUSH_TEST_GUARD", "class_name": "OwnerPushTestGuard" }]
  },
  "kv_namespaces": [
    {
      "binding": "COURSE_SUBSCRIPTIONS",
      "id": "635b6023022f4b118dcd73ace8b16ecd"
    }
  ],
  "migrations": [{ "tag": "owner-push-test-v1", "new_sqlite_classes": ["OwnerPushTestGuard"] }],
  "compatibility_date": "2026-09-13",
  "vars": {
    "FIREBASE_PROJECT_ID": "lumina-cc",
    "ALLOWED_ORIGIN": "https://polskieradio.cc",
    "FIREBASE_WEB_API_KEY": "AIzaSyAkX7XDMWjeUPeaIk0WdvoY4d9VhIPyD7M",
    "COURSE_PUSH_ENABLED": "true"
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  }
}
