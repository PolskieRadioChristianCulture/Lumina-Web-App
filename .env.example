# ============================================================================
# EkoCC / CC NEWSLETTER — Konfiguracja Środowiskowa (.env.example)
# UWAGA: Plik przykładowy bez prawdziwych sekretów i kluczy API (Standard ZERO COST)
# ============================================================================

# Tryb dostawy e-mail:
# false (domyślnie) = bezpieczny tryb kolejki / dry-run (0 zł kosztów, brak wychodzących połączeń SMTP/API)
# true = aktywna wysyłka przez skonfigurowany darmowy transport po zatwierdzeniu przez Właściciela (L0)
NEWSLETTER_DELIVERY_ENABLED=false

# Kanoniczny publiczny adres ekosystemu do budowy linków DOI, zarządzania i wypisu
NEWSLETTER_PUBLIC_BASE_URL=https://polskieradio.cc

# Dane nadawcy (wymagają domeny ze skonfigurowanym SPF, DKIM i DMARC przed włączeniem produkcji)
NEWSLETTER_FROM_EMAIL=newsletter@polskieradio.cc
NEWSLETTER_FROM_NAME=Christian Culture • EkoCC Newsletter
NEWSLETTER_REPLY_TO=radiochristianculture@gmail.com

# Aktualna wersja klauzuli zgody RODO / PKE Art. 398
NEWSLETTER_CONSENT_VERSION=2026-10-30-v1

# Sól kryptograficzna do nieodwracalnego hashowania adresów IP oraz User-Agent (SHA-256)
NEWSLETTER_HASH_SALT=change-me-in-cloudflare-secrets-never-commit-real-value

# Sekret administracyjny RBAC dla panelu /newsletter/admin i endpointów /api/newsletter/admin/*
NEWSLETTER_ADMIN_SECRET=change-me-in-cloudflare-secrets-never-commit-real-value

# Sekret HMAC-SHA256 do weryfikacji webhooków odbić i skarg spamowych (/api/newsletter/webhooks/delivery)
NEWSLETTER_WEBHOOK_SECRET=change-me-in-cloudflare-secrets-never-commit-real-value

# Bezpiecznik dziennego limitu darmowego planu (zatrzymuje wysyłkę przy 80% limitu Free Tier)
NEWSLETTER_DAILY_QUOTA_LIMIT=100
NEWSLETTER_QUOTA_SAFETY_RATIO=0.8

# Opcjonalny klucz Cloudflare Turnstile (ochrona formularza przed botami)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============================================================================
# AUTOMATYZACJA PUBLIKACJI NA PLATFORMĘ X (TWITTER) — 0 ZŁ (FREE TIER)
# Pobierz z: https://developer.x.com -> Developer Portal -> Projects & Apps
# Uprawnienia kluczy (User authentication settings): "Read and write"
# ============================================================================
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
