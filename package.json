{
  "name": "polskieradio-christian-culture",
  "version": "1.0.0",
  "description": "PolskieRadio.cc - Globalne Polskie Radio Internetowe & Christian Culture",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "node server.js",
    "dev:lumina": "vite",
    "build:lumina": "vite build",
    "start": "node server.js",
    "build": "vite build",
    "test:guardian": "node straznik-kodu-check.js",
    "test:guardian:extended": "node scripts/straznik-kodu-check.js",
    "test:smoke": "node scripts/lumina-smoke-check.js",
    "test:inline": "node validate_lumina.js",
    "test:unit": "vitest run",
    "test:all": "npm run test:unit && npm run test:guardian:extended && npm run build:lumina",
    "test": "npm run test:all",
    "matrix": "node scripts/agent-matrix/launch_grid.js",
    "matrix:local": "node scripts/agent-matrix/launch_grid.js --local"
  },
  "dependencies": {
    "express": "^4.19.2",
    "firebase": "^12.18.0",
    "pinia": "^4.0.3",
    "sharp": "^0.35.3",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.11.15",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  }
}
