{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"CC Help private institution research record — never publish raw records",
  "type":"object",
  "additionalProperties":false,
  "required":["id","name","country","category","website","contacts","sources","verification","relationship","visibility","outreach"],
  "properties":{
    "id":{"type":"string","pattern":"^CCDIR-[A-Z]{2}-[0-9]{4}$"},
    "name":{"type":"string","minLength":1,"maxLength":200},
    "country":{"type":"string","pattern":"^[A-Z]{2}$"},
    "category":{"enum":["charity","education","media","health","senior-care","recreation","faith","other"]},
    "website":{"type":"string","format":"uri","pattern":"^https://"},
    "contacts":{"type":"array","maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["type","value","scope","sourceUrl"],"properties":{"type":{"enum":["email","contact-page","office-phone"]},"value":{"type":"string","minLength":1,"maxLength":300},"scope":{"const":"shared-institutional"},"sourceUrl":{"type":"string","format":"uri","pattern":"^https://"}}}},
    "sources":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["url","kind","checkedDate"],"properties":{"url":{"type":"string","format":"uri","pattern":"^https://"},"kind":{"enum":["official-directory","organization-website"]},"checkedDate":{"type":"string","format":"date"}}}},
    "verification":{"enum":["DISCOVERED","DIRECTORY_ONLY","OFFICIAL_SITE_CHECKED","NEEDS_RECHECK"]},
    "relationship":{"enum":["UNCONTACTED","INVITED","RESPONDED","VERIFIED_PARTNER","DECLINED"]},
    "visibility":{"const":"PRIVATE"},
    "outreach":{"type":"object","additionalProperties":false,"required":["sendAllowed","sentAt"],"properties":{"sendAllowed":{"const":false},"sentAt":{"type":"null"}}},
    "notes":{"type":"string","maxLength":1000}
  }
}
