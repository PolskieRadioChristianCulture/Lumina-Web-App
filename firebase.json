{
  "hosting": [
    {
      "target": "lumina",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.py",
        "**/*.bat",
        "**/*.ps1",
        "**/*.zip",
        "audio/**",
        "downloads/**"
      ],
      "rewrites": [
        { "source": "/lumina", "destination": "/lumina.html" },
        { "source": "/tablica", "destination": "/lumina-tablica.html" },
        { "source": "/profil", "destination": "/lumina-profile.html" }
      ]
    },
    {
      "target": "ccglobal",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.py",
        "**/*.bat",
        "**/*.ps1",
        "**/*.zip",
        "audio/**",
        "downloads/**"
      ],
      "rewrites": [
        { "source": "/lumina", "destination": "/lumina.html" },
        { "source": "/tablica", "destination": "/lumina-tablica.html" },
        { "source": "/profil", "destination": "/lumina-profile.html" }
      ]
    }
  ]
}
