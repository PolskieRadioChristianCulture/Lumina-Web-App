        "tapeta_modlitwa.gif",
        "functions/**",
        "audio/**",
        "downloads/**"
      ],
      "redirects": [
        {
          "source": "/snadaniowa-live-worship.html",
          "destination": "/cctv24-worship.html",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/lumina",
