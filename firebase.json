{
  "hosting": [
    {
      "target": "lumina",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".git/**",
        ".github/**",
        ".agents/**",
        ".firebase/**",
        ".gemini/**",
        ".vscode/**",
        "**/.*",
        "**/node_modules/**",
        "**/*.py",
        "**/*.bat",
        "**/*.ps1",
        "**/*.zip",
        "tapeta_modlitwa.gif",
        "functions/**",
        "audio/**",
        "downloads/**"
      ],
      "redirects": [
        {
          "source": "/snadaniowa-live-worship.html",
          "destination": "/cctv24-worship.html",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/lumina",
          "destination": "/lumina.html"
        },
        {
          "source": "/tablica",
          "destination": "/lumina-tablica.html"
        },
        {
          "source": "/profil",
          "destination": "/lumina-profile.html"
        }
      ],
      "headers": [
        {
          "source": "**/*.@(html|htm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            },
            {
              "key": "Pragma",
              "value": "no-cache"
            },
            {
              "key": "Expires",
              "value": "0"
            }
          ]
        },
        {
          "source": "sw-lumina.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "firebase-messaging-sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        }
      ]
    },
    {
      "target": "ccglobal",
      "public": ".",
      "ignore": [
