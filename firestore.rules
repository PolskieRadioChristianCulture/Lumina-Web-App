rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anonymous Firebase sessions may browse public content, but never publish,
    // message, react, or change another person's data.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMember() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true &&
         request.auth.token.email == 'nazirczarkes@gmail.com')
      );
    }

    function ownsProfile(data) {
      return isMember() && data.uid is string && data.uid == request.auth.uid;
    }

    function isMessageParticipant(data) {
      return isMember() && (
        data.senderAuthUid == request.auth.uid ||
        data.receiverAuthUid == request.auth.uid ||
        (data.participants is list && request.auth.uid in data.participants) ||
        // Historical messages used `users`; retain access only where the
        // authenticated UID is explicitly present in the existing document.
        (data.users is list && request.auth.uid in data.users)
      );
    }

    function directMessageAllowed(data) {
      return data.senderAuthUid != data.receiverAuthUid &&
        data.participants.size() == 2 &&
        data.senderAuthUid in data.participants &&
        data.receiverAuthUid in data.participants &&
        !exists(/databases/$(database)/documents/lumina_user_blocks/$(request.auth.uid + '_' + data.receiverAuthUid)) &&
        !exists(/databases/$(database)/documents/lumina_user_blocks/$(data.receiverAuthUid + '_' + request.auth.uid));
    }

    match /lumina_profiles/{profileId} {
      // Public profile cards must contain only intentionally public fields.
      allow read: if true;
      allow create: if isMasterAdmin() || ownsProfile(request.resource.data);
      allow update: if isMasterAdmin() || (
        ownsProfile(resource.data) &&
        request.resource.data.uid == resource.data.uid
      );
      allow delete: if isMasterAdmin() || ownsProfile(resource.data);
    }

    match /lumina_posts/{postId} {
      allow read: if true;
      // Automatyczny serwer sync CKD (Andrzej Thiel) oraz oficjalne rozważania DZJ (Cezary Rogowski)
      allow create: if isMasterAdmin() ||
        (
          request.resource.data.isDevotion == true &&
          (
            (request.resource.data.authorSlug == 'andrzejthiel' && request.resource.data.category == 'ckd') ||
            (request.resource.data.authorSlug == 'cezaryrgowski')
          ) &&
          request.resource.data.text is string
        ) ||
        (
          isMember() &&
          request.resource.data.authorUid == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 5000
        );
      allow update: if isMasterAdmin() ||
        (
          resource.data.isDevotion == true &&
          (
            (resource.data.authorSlug == 'andrzejthiel' && resource.data.category == 'ckd') ||
            (resource.data.authorSlug == 'cezaryrgowski')
          )
        ) || (
          isMember() &&
          resource.data.authorUid == request.auth.uid &&
          request.resource.data.authorUid == resource.data.authorUid
        );
      allow delete: if isMasterAdmin() ||
        (
          resource.data.isDevotion == true &&
          (
            (resource.data.authorSlug == 'andrzejthiel' && resource.data.category == 'ckd') ||
            (resource.data.authorSlug == 'cezaryrgowski')
          )
        ) || (
          isMember() && resource.data.authorUid == request.auth.uid
        );
    }

    match /lumina_campaigns/{campaignId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /lumina_direct_messages/{messageId} {
      allow read: if isMasterAdmin() || isMessageParticipant(resource.data);
      allow create: if isMasterAdmin() || (
        isMember() &&
        request.resource.data.senderAuthUid == request.auth.uid &&
        request.resource.data.receiverAuthUid is string &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants &&
        directMessageAllowed(request.resource.data) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 4000
      );
      allow update: if isMasterAdmin() || (
        isMessageParticipant(resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead', 'status', 'readAt', 'readByName', 'readBy', 'reactions', 'seenBy'
        ])
      );
      allow delete: if isMasterAdmin() || (
        isMember() && resource.data.senderAuthUid == request.auth.uid
      );
    }

    match /lumina_message_requests/{requestId} {
      allow read: if isMasterAdmin() || isMessageParticipant(resource.data);
      allow create: if isMasterAdmin() || (
        isMember() &&
        request.resource.data.senderAuthUid == request.auth.uid &&
        request.resource.data.receiverAuthUid is string &&
        request.resource.data.participants is list &&
        request.resource.data.previewText is string &&
        request.resource.data.previewText.size() <= 1000 &&
        request.resource.data.status == 'pending' &&
        directMessageAllowed(request.resource.data)
      );
      allow update: if isMasterAdmin() || (
        isMember() && resource.data.receiverAuthUid == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['accepted', 'declined', 'blocked'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedBy', 'respondedAt', 'respondedBy'])
      );
      allow delete: if isMasterAdmin();
    }

    match /lumina_public_chat_messages/{messageId} {
      allow read: if true;
      allow create: if isMasterAdmin() || (
        isMember() &&
        request.resource.data.senderAuthUid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 2000
      );
      allow update: if isMasterAdmin() || (
        isMember() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'seenBy'])
      );
      allow delete: if isMasterAdmin() || (
        isMember() && resource.data.senderAuthUid == request.auth.uid
      );
    }

    match /lumina_chats/{chatId} {
      allow read: if isMasterAdmin() || isMessageParticipant(resource.data);
      allow create: if isMasterAdmin() || (
        isMember() &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants
      );
      allow update: if isMasterAdmin() || isMessageParticipant(resource.data);
      allow delete: if isMasterAdmin();

      match /messages/{messageId} {
        allow read: if isMasterAdmin() || isMessageParticipant(resource.data);
        allow create: if isMasterAdmin() || (
          isMember() &&
          request.resource.data.senderAuthUid == request.auth.uid &&
          request.resource.data.participants is list &&
          request.auth.uid in request.resource.data.participants &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 4000
        );
        allow update: if isMasterAdmin() || (
          isMessageParticipant(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead', 'status', 'readAt', 'readByName', 'readBy', 'reactions', 'seenBy'
          ])
        );
        allow delete: if isMasterAdmin() || (
          isMember() && resource.data.senderAuthUid == request.auth.uid
        );
      }
    }

    match /lumina_reports/{reportId} {
      allow create: if isMember() &&
        request.resource.data.reporterAuthUid == request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() <= 500;
      allow read, update, delete: if isMasterAdmin();
    }

    // Relationship data is readable only by its owner or trusted moderation.
    // Cloud Functions use Admin SDK and are not restricted by these client rules.
    match /lumina_likes/{likeId} {
      allow read: if isMasterAdmin() || (
        isMember() && resource.data.fromAuthUid == request.auth.uid
      );
      allow create: if isMember() &&
        request.resource.data.fromAuthUid == request.auth.uid &&
        request.resource.data.type is string;
      allow update: if false;
      allow delete: if isMasterAdmin() || (
        isMember() && resource.data.fromAuthUid == request.auth.uid
      );
    }

    match /lumina_user_blocks/{blockId} {
      allow read: if isMasterAdmin() || (
        isMember() && resource.data.ownerUid == request.auth.uid
      );
      allow create: if isMember() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isMasterAdmin() || (
        isMember() && resource.data.ownerUid == request.auth.uid
      );
    }

    match /lumina_presence/{presenceId} {
      allow read: if true;
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isMasterAdmin() || (
        isMember() && resource.data.uid == request.auth.uid
      );
    }

    // Notifications are generated only by trusted server functions.
    match /lumina_notifications/{notifId} {
      allow read, write: if isMasterAdmin();
    }

    match /lumina_notifications/{userId}/archive/{item} {
      allow read: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
      allow update, delete: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
      allow create: if isMasterAdmin();
    }

    match /lumina_notification_preferences/{userId} {
      allow read, write: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
    }

    match /LuminaDeviceTokens/{tokenId} {
      allow read: if isMasterAdmin();
      allow create, update: if isMember() && request.resource.data.uid == request.auth.uid;
      allow delete: if isMasterAdmin() || (
        isMember() && resource.data.uid == request.auth.uid
      );
    }

    match /prayer_intentions/{intentionId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'city', 'text', 'approved', 'status', 'timestamp'
      ]) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        request.resource.data.city is string && request.resource.data.city.size() > 0 && request.resource.data.city.size() <= 120 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
        request.resource.data.approved == false &&
        request.resource.data.status == 'pending';
      allow read: if isMasterAdmin() || resource.data.approved == true;
      allow update, delete: if isMasterAdmin();
    }
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }
  }
}
