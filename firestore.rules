rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Master admin helper
    function isMasterAdmin() {
      return request.auth != null && (
        request.auth.token.email == 'nazirczarkes@gmail.com' ||
        request.auth.uid == 'nazirczarkes'
      );
    }
    
    // Public read and author edit for Lumina profiles
    match /lumina_profiles/{profileId} {
      allow read: if true;
      allow write: if isMasterAdmin() || request.auth != null || resource == null;
    }
    
    // Public read, authenticated or guest create for posts
    match /lumina_posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin() || request.auth != null;
    }
    
    // Public read for CC Mission Campaigns
    match /lumina_campaigns/{campaignId} {
      allow read: if true;
      allow write: if isMasterAdmin() || request.auth != null;
    }
    
    // Direct Chats & Messages (Top-level and Nested)
    match /lumina_direct_messages/{messageId} {
      allow read, write: if true;
    }

    match /lumina_public_chat_messages/{messageId} {
      allow read, write: if true;
    }

    match /lumina_chats/{chatId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    // Moderation Reports (Any user can submit a report, admin has full read/manage access)
    match /lumina_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if isMasterAdmin() || request.auth != null;
    }
    
    // Default fallback
    match /{document=**} {
      allow read: if true;
      allow write: if isMasterAdmin() || request.auth != null;
    }
  }
}
