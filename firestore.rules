rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Public read and author edit for Lumina profiles
    match /lumina_profiles/{profileId} {
      allow read: if true;
      allow write: if request.auth != null || resource == null;
    }
    
    // Public read, authenticated or guest create for posts
    match /lumina_posts/{postId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
    
    // Public read for CC Mission Campaigns
    match /lumina_campaigns/{campaignId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Direct Chats & Messages
    match /lumina_chats/{chatId} {
      allow read, write: if true;
      
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }
    
    // Moderation Reports (Any user can submit a report, read restricted)
    match /lumina_reports/{reportId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
    
    // Default fallback
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
