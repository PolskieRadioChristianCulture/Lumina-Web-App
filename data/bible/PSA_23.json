      "text": {
        "UBG": "PAN jest moim pasterzem, niczego mi nie zabraknie.",
        "BW": "Pan jest pasterzem moim, niczego mi nie braknie.",
        "BT": "Pan jest moim pasterzem, nie brak mi niczego.",
        "BG": "Pan jest pasterzem moim, na niczem mi nie zejdzie."
